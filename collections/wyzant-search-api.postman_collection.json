                  "value": "<string>",
                  "description": "(Required) Wyzant-issued partner API key (GUID) used for conversion tracking."
                },
                {
                  "disabled": false,
                  "key": "SearchString",
                  "value": "<string>",
                  "description": "Free-text search string, typically a subject (e.g. \"Accounting\", \"Excel\")."
                },
                {
                  "disabled": false,
                  "key": "ZIP",
                  "value": "<string>",
                  "description": "US ZIP code to center a location-based search."
                },
